{
  "name": "jules-api",
  "version": "0.0.0",
  "scripts": {
    "ng": "NG_CLI_ANALYTICS=false ng",
    "start": "NG_CLI_ANALYTICS=false ng serve --port 4700",
    "dev": "NG_CLI_ANALYTICS=false ng serve --port 4700",
    "build": "NG_CLI_ANALYTICS=false ng build",
    "watch": "NG_CLI_ANALYTICS=false ng build --watch --configuration development",
    "test": "NG_CLI_ANALYTICS=false ng test",
    "test:ci": "NG_CLI_ANALYTICS=false ng test --watch=false",
    "test:coverage": "NG_CLI_ANALYTICS=false ng test --code-coverage --watch=false",
    "lint": "NG_CLI_ANALYTICS=false ng lint",
    "format": "prettier --write .",
    "clean": "rm -rf dist .angular",
    "test:a11y": "playwright test",
    "analyze:bundles": "NG_CLI_ANALYTICS=false ng build --configuration production --stats-json && source-map-explorer dist/frontend/browser/*.js",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.4",
    "express": "^5.1.0",
    "marked": "^17.0.1",
    "ngx-markdown": "^21.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^19.7.1",
    "@angular-eslint/eslint-plugin": "^19.7.1",
    "@angular-eslint/eslint-plugin-template": "^19.7.1",
    "@angular-eslint/template-parser": "^19.7.1",
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^8.57.1",
    "jsdom": "^27.1.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.3",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
